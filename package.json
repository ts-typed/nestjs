{
    "name": "@ts-typed/nestjs",
    "version": "0.1.21",
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "description": "NestJS integration for ts-typed: project resolution adapter and StrictTypeError HTTP exception filter",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=18"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE",
        "NOTICE",
        "README.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "tsc",
        "test": "npm run build && node --test --test-concurrency=1"
    },
    "dependencies": {
        "@ts-typed/compiler": "0.1.27"
    },
    "peerDependencies": {
        "@nestjs/common": ">=10 <13",
        "@nestjs/core": ">=10 <13",
        "typescript": ">=5.4 <7"
    },
    "devDependencies": {
        "@nestjs/common": "12.1.3",
        "@nestjs/core": "12.1.3",
        "@nestjs/platform-express": "12.1.3",
        "@nestjs/testing": "12.1.3",
        "@types/node": "^22.15.21",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "typescript": "5.9.3"
    }
}
